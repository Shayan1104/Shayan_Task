# ==========================================
# DataEmbedder AI Environment Configuration
# ==========================================

# Groq API Key (Fast inference for Llama 3.3 70B & 3.1 8B)
# Get your free key from: https://console.groq.com/keys
GROQ_API_KEY=

# Preferred Groq Model: llama-3.3-70b-versatile or llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# Default LLM Provider: groq, gemini, openai, or local
DEFAULT_LLM_PROVIDER=groq

# Optional: Google Gemini API Key
GEMINI_API_KEY=

# Optional: OpenAI API Key
OPENAI_API_KEY=
